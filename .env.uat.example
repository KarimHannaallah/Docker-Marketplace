# Environnement UAT : recette utilisateur, ressources moyennes, conditions proches de la production.
# Lancer :  cp .env.uat.example .env.uat   puis   docker compose --env-file .env.uat up -d --build
# Cet environnement peut tourner EN MÊME TEMPS que TEST et PROD : projet, port, base et volume sont distincts.

# --- Projet Compose : préfixe de tous les conteneurs, réseaux et volumes (doit être unique par environnement) ---
COMPOSE_PROJECT_NAME=marketplace-uat

# --- Port d'accès (seul port publié) ---
FRONTEND_PORT=8082

# --- PostgreSQL : base et utilisateur propres à cet environnement ---
POSTGRES_USER=marketplace_uat
POSTGRES_PASSWORD=uat-db-password
POSTGRES_DB=marketplace_uat
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Doit rester cohérente avec les trois variables ci-dessus
DATABASE_URL=postgresql://marketplace_uat:uat-db-password@db:5432/marketplace_uat

# --- JWT : secret différent par environnement (un token UAT est refusé en TEST et en PROD) ---
JWT_SECRET=uat-env-jwt-secret-not-for-production-0002
JWT_EXPIRES_IN=2h

# --- Compte ADMIN créé au démarrage de auth-service ---
ADMIN_EMAIL=admin@uat.example.com
ADMIN_PASSWORD=uat-admin-password
ADMIN_NAME=Admin UAT

# --- Limites de ressources : MOYENNES ---
DB_CPU_LIMIT=1
DB_MEM_LIMIT=512M
DB_CPU_RESERVATION=0.25
DB_MEM_RESERVATION=256M

AUTH_CPU_LIMIT=0.5
AUTH_MEM_LIMIT=256M
AUTH_CPU_RESERVATION=0.1
AUTH_MEM_RESERVATION=128M

CATALOG_CPU_LIMIT=0.5
CATALOG_MEM_LIMIT=256M
CATALOG_CPU_RESERVATION=0.1
CATALOG_MEM_RESERVATION=128M

ORDER_CPU_LIMIT=0.5
ORDER_MEM_LIMIT=256M
ORDER_CPU_RESERVATION=0.1
ORDER_MEM_RESERVATION=128M

FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEM_LIMIT=128M
FRONTEND_CPU_RESERVATION=0.05
FRONTEND_MEM_RESERVATION=64M

# --- Ports et URLs internes (information : fixés par les images et par docker-compose.yml) ---
AUTH_PORT=3001
CATALOG_PORT=8000
ORDER_PORT=3002
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:8000
