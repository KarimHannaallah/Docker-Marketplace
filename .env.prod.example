# Environnement PROD : ressources hautes, jetons courts (30 minutes).
# Lancer :  cp .env.prod.example .env.prod   puis REMPLACER toutes les valeurs CHANGE_ME,
#           puis   docker compose --env-file .env.prod up -d --build
# Le port 80 doit être libre sur la machine. Cet environnement peut tourner en même temps que TEST et UAT.
#
# ATTENTION : ne jamais committer .env.prod. Chaque valeur CHANGE_ME doit être remplacée par un secret
# généré (par ex. :  openssl rand -base64 48 ). Le service ne doit pas être démarré avec ces valeurs d'exemple.

# --- Projet Compose : préfixe de tous les conteneurs, réseaux et volumes (doit être unique par environnement) ---
COMPOSE_PROJECT_NAME=marketplace-prod

# --- Port d'accès (seul port publié) ---
FRONTEND_PORT=80

# --- PostgreSQL : base et utilisateur propres à cet environnement ---
POSTGRES_USER=marketplace_prod
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=marketplace_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Doit rester cohérente avec les trois variables ci-dessus (même mot de passe que POSTGRES_PASSWORD)
DATABASE_URL=postgresql://marketplace_prod:CHANGE_ME_DB_PASSWORD@db:5432/marketplace_prod

# --- JWT : secret différent par environnement (un token TEST ou UAT est refusé en PROD) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=30m

# --- Compte ADMIN créé au démarrage de auth-service ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Administrateur

# --- Limitation du débit de auth-service, par adresse IP ---
# Au-delà de la limite, le service répond 429 (Too Many Requests) jusqu'à la fin de la fenêtre.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Limites de ressources : HAUTES ---
DB_CPU_LIMIT=2
DB_MEM_LIMIT=1G
DB_CPU_RESERVATION=0.5
DB_MEM_RESERVATION=512M

AUTH_CPU_LIMIT=1
AUTH_MEM_LIMIT=512M
AUTH_CPU_RESERVATION=0.25
AUTH_MEM_RESERVATION=256M

CATALOG_CPU_LIMIT=1
CATALOG_MEM_LIMIT=512M
CATALOG_CPU_RESERVATION=0.25
CATALOG_MEM_RESERVATION=256M

ORDER_CPU_LIMIT=1
ORDER_MEM_LIMIT=512M
ORDER_CPU_RESERVATION=0.25
ORDER_MEM_RESERVATION=256M

FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=256M
FRONTEND_CPU_RESERVATION=0.1
FRONTEND_MEM_RESERVATION=128M

# --- Ports et URLs internes (information : fixés par les images et par docker-compose.yml) ---
AUTH_PORT=3001
CATALOG_PORT=8000
ORDER_PORT=3002
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:8000
