# Environnement TEST : recette technique, ressources basses, jetons longs pour ne pas se reconnecter.
# Lancer :  cp .env.test.example .env.test   puis   docker compose --env-file .env.test up -d --build
# Cet environnement peut tourner EN MÊME TEMPS que UAT et PROD : projet, port, base et volume sont distincts.

# --- Projet Compose : préfixe de tous les conteneurs, réseaux et volumes (doit être unique par environnement) ---
COMPOSE_PROJECT_NAME=marketplace-test

# --- Port d'accès (seul port publié) ---
FRONTEND_PORT=8081

# --- PostgreSQL : base et utilisateur propres à cet environnement ---
POSTGRES_USER=marketplace_test
POSTGRES_PASSWORD=test-db-password
POSTGRES_DB=marketplace_test
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Doit rester cohérente avec les trois variables ci-dessus
DATABASE_URL=postgresql://marketplace_test:test-db-password@db:5432/marketplace_test

# --- JWT : secret différent par environnement (un token TEST est refusé en UAT et en PROD) ---
JWT_SECRET=test-env-jwt-secret-not-for-production-0001
JWT_EXPIRES_IN=8h

# --- Compte ADMIN créé au démarrage de auth-service ---
ADMIN_EMAIL=admin@test.example.com
ADMIN_PASSWORD=test-admin-password
ADMIN_NAME=Admin TEST

# --- Limitation du débit de auth-service, par adresse IP ---
# Au-delà de la limite, le service répond 429 (Too Many Requests) jusqu'à la fin de la fenêtre.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Limites de ressources : BASSES ---
DB_CPU_LIMIT=0.5
DB_MEM_LIMIT=256M
DB_CPU_RESERVATION=0.1
DB_MEM_RESERVATION=128M

AUTH_CPU_LIMIT=0.25
AUTH_MEM_LIMIT=192M
AUTH_CPU_RESERVATION=0.05
AUTH_MEM_RESERVATION=96M

CATALOG_CPU_LIMIT=0.25
CATALOG_MEM_LIMIT=192M
CATALOG_CPU_RESERVATION=0.05
CATALOG_MEM_RESERVATION=96M

ORDER_CPU_LIMIT=0.25
ORDER_MEM_LIMIT=192M
ORDER_CPU_RESERVATION=0.05
ORDER_MEM_RESERVATION=96M

FRONTEND_CPU_LIMIT=0.1
FRONTEND_MEM_LIMIT=64M
FRONTEND_CPU_RESERVATION=0.02
FRONTEND_MEM_RESERVATION=32M

# --- Ports et URLs internes (information : fixés par les images et par docker-compose.yml) ---
AUTH_PORT=3001
CATALOG_PORT=8000
ORDER_PORT=3002
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:8000
