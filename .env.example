# Copier ce fichier en `.env` et adapter les valeurs. Ne jamais committer `.env`.

# --- PostgreSQL ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketplace
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL de connexion utilisée par les 3 services (un schéma par service)
DATABASE_URL=postgresql://marketplace:change-me@db:5432/marketplace

# --- JWT (HS256) ---
# Secret partagé : auth-service signe, catalog-service et order-service vérifient.
JWT_SECRET=change-me-to-a-long-random-string
# Durée de vie du token (ex: 1h, 30m)
JWT_EXPIRES_IN=1h

# --- Compte ADMIN créé au démarrage de auth-service (seed idempotent) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Administrateur

# --- Limites de ressources par conteneur (valeurs par défaut, toutes facultatives) ---
# CPU : nombre de cœurs (0.5 = un demi-cœur). Mémoire : 256M, 1G...
# LIMIT = plafond ; RESERVATION = minimum garanti. Un conteneur qui dépasse sa limite mémoire est redémarré.
DB_CPU_LIMIT=1
DB_MEM_LIMIT=512M
DB_CPU_RESERVATION=0.25
DB_MEM_RESERVATION=256M

AUTH_CPU_LIMIT=0.5
AUTH_MEM_LIMIT=256M
AUTH_CPU_RESERVATION=0.1
AUTH_MEM_RESERVATION=128M

CATALOG_CPU_LIMIT=0.5
CATALOG_MEM_LIMIT=256M
CATALOG_CPU_RESERVATION=0.1
CATALOG_MEM_RESERVATION=128M

ORDER_CPU_LIMIT=0.5
ORDER_MEM_LIMIT=256M
ORDER_CPU_RESERVATION=0.1
ORDER_MEM_RESERVATION=128M

FRONTEND_CPU_LIMIT=0.25
FRONTEND_MEM_LIMIT=128M
FRONTEND_CPU_RESERVATION=0.05
FRONTEND_MEM_RESERVATION=64M

# --- Port d'accès à l'application (seul port publié par docker compose) ---
FRONTEND_PORT=8080

# --- Ports internes des services (fixés dans les images Docker, ne pas modifier avec compose) ---
AUTH_PORT=3001
CATALOG_PORT=8000
ORDER_PORT=3002

# --- URLs internes (réseau Docker) ---
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:8000
