# Copier ce fichier en `.env` et adapter les valeurs. Ne jamais committer `.env`.

# --- PostgreSQL ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketplace
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL de connexion utilisée par les 3 services (un schéma par service)
DATABASE_URL=postgresql://marketplace:change-me@db:5432/marketplace

# --- JWT (HS256) ---
# Secret partagé : auth-service signe, catalog-service et order-service vérifient.
JWT_SECRET=change-me-to-a-long-random-string
# Durée de vie du token (ex: 1h, 30m)
JWT_EXPIRES_IN=1h

# --- Compte ADMIN créé au démarrage de auth-service (seed idempotent) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Administrateur

# --- Port d'accès à l'application (seul port publié par docker compose) ---
FRONTEND_PORT=8080

# --- Ports internes des services (fixés dans les images Docker, ne pas modifier avec compose) ---
AUTH_PORT=3001
CATALOG_PORT=8000
ORDER_PORT=3002

# --- URLs internes (réseau Docker) ---
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:8000
